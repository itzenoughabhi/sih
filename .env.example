# BhuSync AI — Environment Configuration Example

# Backend Settings
APP_ENV=development
APP_PORT=8000
SECRET_KEY=bhusync_hackathon_super_secret_key_2026_dev_only
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration
# For PostgreSQL / PostGIS:
# DATABASE_URL=postgresql://bhusync:bhusync_secure_password@localhost:5432/bhusync_db
# For SQLite Fallback (Zero Setup, self-contained in backend):
DATABASE_URL=sqlite:///./backend/bhusync.db

# GIS & Data Paths
DATA_DIR=./backend/data
DEMO_DIR=./backend/data/demo
UPLOAD_DIR=./backend/data/uploads
DEFAULT_PROJECT_CRS=EPSG:4326
METRIC_PROJECTION_CRS=EPSG:32643
MAX_UPLOAD_SIZE_MB=25

# Frontend Public Environment Variables (Set on Vercel)
# In production on Vercel, set NEXT_PUBLIC_API_URL to your deployed backend URL:
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_MAP_STYLE=https://demotiles.maplibre.org/style.json

